{
  "version": "1.0",
  "project": "",
  "branch": "pre-dev",
  "rules": {
    "structureEditableBy": "editor",
    "enforcedAssignment": false
  },
  "fields": [
    {
      "id": "evidence",
      "label": "Evidence / Reference",
      "type": "textarea",
      "requiredWhen": ["fail"],
      "editableBy": "full",
      "visibleTo": "observer",
      "maxLength": 1000
    },
    {
      "id": "justification",
      "label": "Justification",
      "type": "textarea",
      "requiredWhen": ["fail", "na"],
      "editableBy": "full",
      "visibleTo": "observer",
      "maxLength": 1000
    },
    {
      "id": "disposition",
      "label": "Disposition",
      "type": "select",
      "options": ["Out of Scope", "Not Applicable", "Deferred", "Risk Accepted"],
      "requiredWhen": ["na"],
      "editableBy": "full",
      "visibleTo": "observer"
    },
    {
      "id": "approval_decision",
      "label": "Approval Decision",
      "type": "select",
      "options": ["Approved", "Conditionally Approved", "Rejected"],
      "requiredWhen": ["pass", "fail"],
      "editableBy": "approver",
      "visibleTo": "full"
    },
    {
      "id": "comment",
      "label": "Comment",
      "type": "textarea",
      "requiredWhen": [],
      "editableBy": "full",
      "visibleTo": "observer",
      "maxLength": 500
    }
  ],
