{
  "version": "1.0",
  "project": "",
  "branch": "pre-dev",
  "rules": {
    "structureEditableBy": "editor",
    "enforcedAssignment": false
  },
  "fields": [
    {
      "id": "finding_ref",
      "label": "Finding Reference / Ticket",
      "type": "url",
      "requiredWhen": ["fail"],
      "editableBy": "full",
      "visibleTo": "observer"
    },
    {
      "id": "evidence",
      "label": "Evidence / Report Link",
      "type": "url",
      "requiredWhen": ["fail"],
      "editableBy": "full",
      "visibleTo": "observer"
    },
    {
      "id": "remediation_notes",
      "label": "Remediation Notes",
      "type": "textarea",
      "requiredWhen": ["fail"],
      "editableBy": "full",
      "visibleTo": "observer",
      "maxLength": 1000
    },
    {
      "id": "disposition",
      "label": "Disposition",
      "type": "select",
      "options": ["Out of Scope", "Not Applicable", "Risk Accepted", "Deferred"],
      "requiredWhen": ["na"],
      "editableBy": "full",
      "visibleTo": "observer"
    },
    {
      "id": "comment",
      "label": "Comment",
      "type": "textarea",
      "requiredWhen": [],
      "editableBy": "full",
      "visibleTo": "observer",
      "maxLength": 500
    }
  ],
